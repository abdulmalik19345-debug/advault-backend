{
  "manifest_version": 3,
  "name": "AdVault Spy",
  "version": "1.3.3",
  "description": "AI-powered ad intelligence and business prospecting workspace.",
  "action": {
    "default_title": "AdVault Spy",
    "default_popup": "popup.html"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
