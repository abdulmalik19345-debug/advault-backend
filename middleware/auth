// middleware/auth.js
// ============================================================================
// requireAuth — protects every endpoint that must be tied to an authenticated
// user. Identity is derived ONLY from the server-side session record matched
// by the presented bearer token. Client-side values (localStorage,
// chrome.storage, URL params, request-body plan fields) are never trusted.
// ============================================================================

const { hashSessionToken } = require("../lib/sessions");

function createRequireAuth({ store, secret }) {
    return async function requireAuth(req, res, next) {
        try {
            const header = req.headers.authorization || "";
            const token = header.startsWith("Bearer ")
                ? header.slice("Bearer ".length).trim()
                : "";

            if (!token) {
                return res
                    .status(401)
                    .json({ error: "Authentication required." });
            }

            const tokenHash = hashSessionToken(token, secret);
            const session = await store.findSessionByTokenHash(tokenHash);

            if (!session) {
                return res.status(401).json({
                    error: "Invalid or expired session. Please log in again.",
                });
            }

            if (new Date(session.expiresAt).getTime() < Date.now()) {
                await store.deleteSessionByTokenHash(tokenHash);
                return res.status(401).json({
                    error: "Session expired. Please log in again.",
                });
            }

            const user = await store.findUserById(session.userId);
            if (!user) {
                return res.status(401).json({
                    error: "Account not found. Please log in again.",
                });
            }

            req.user = user;
            req.sessionTokenHash = tokenHash;
            return next();
        } catch (err) {
            return next(err);
        }
    };
}

module.exports = { createRequireAuth };
