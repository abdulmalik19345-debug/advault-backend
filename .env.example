# AdVault Spy Backend — environment template
# Copy this file to .env and fill in your values. Never commit .env.

# ---- Server ----
# Unprivileged port. Keep 3000 even in production — a reverse proxy
# (nginx/Caddy/Render/Railway) forwards external traffic to it.
PORT=3000
# development | production. Set to production for real deployments.
NODE_ENV=development

# ---- Secrets (REQUIRED in production) ----
# Key for HMAC-signing session tokens (lib/sessions.js). MUST be a long random
# string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Rotating this invalidates every active session.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional extra secret mixed into scrypt password hashing (lib/password.js).
# Defaults to SESSION_SECRET. If you set it, use a DISTINCT random value and
# NEVER change it afterwards — changing it invalidates every stored password.
PASSWORD_PEPPER=

# ---- Database ----
# sqlite (local development, persistent single-file DB) | memory (DEVELOPMENT ONLY,
# resets on restart) | postgres (PRODUCTION — Supabase PostgreSQL).
# In production (Render) set DB_ENGINE=postgres and DATABASE_URL below. If
# DB_ENGINE is unset, the app auto-selects postgres when DATABASE_URL is present.
DB_ENGINE=postgres
# Path to the SQLite file — used only when DB_ENGINE=sqlite (local dev).
# Production MUST NOT use a local file; it runs on Supabase via DATABASE_URL.
# The directory is created automatically. Backup this file if you use it.
DATABASE_FILE=./data/advault.sqlite

# ---- Supabase PostgreSQL (PRODUCTION) ----
# The backend connects to Supabase with this SERVER-SIDE connection string.
# This value MUST stay in .env on the server only — never in the browser, the
# landing page, or the Chrome extension.
#
# How to obtain it:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string ->
#   "Session pooler" (recommended for the long-lived Render Node process).
#   It looks like:
#     postgresql://postgres.<your-project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   Supabase requires TLS; keep the ?sslmode=require suffix. The backend also
#   enables TLS automatically if the suffix is missing.
#
# The backend creates all tables automatically on first boot (see
# db/migrations/001_supabase_schema.sql for the reference schema).
DATABASE_URL=YOUR_SUPABASE_POSTGRES_CONNECTION_STRING

# ---- CORS ----
# Comma-separated exact origins allowed for browser clients (the deployed
# landing page). In production list only your real HTTPS origin.
# chrome-extension:// origins are always allowed, and non-browser clients
# (curl, the extension) that send no Origin header are allowed too.
ALLOWED_ORIGINS=https://advaulte.com,http://localhost:5500

# ---- Development-only anonymous extension usage ----
# The Chrome extension no longer logs users in (auth moved to the landing page).
# Set DEV_ANON_USAGE=1 ONLY for local development so the extension can enforce
# the Free usage model (2 scans/day) without a fake login. Requests without a
# Bearer token are then treated as an anonymous FREE-plan client keyed by the
# extension's X-AdVault-Device-Id header. NO user account or session is created.
# PRODUCTION: must be DEV_ANON_USAGE=0 (it is off by default; the landing page
# uses the real /auth endpoints).
DEV_ANON_USAGE=1

# ---- OpenAI (used by /analyze and /generate-hooks) ----
# Required for ad analysis and hook generation. Get a key at
# https://platform.openai.com/api-keys. If unset, those endpoints return HTTP 500.
OPENAI_API_KEY=sk-...

# ---- Stripe (pre-existing, used by /create-checkout-session) ----
# Secret key from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Recurring Price ID from https://dashboard.stripe.com/products (e.g. price_1ABC...)
STRIPE_PRICE_ID=

# Redirect URLs after payment / cancellation. In production use real public
# HTTPS URLs; the your-site.com defaults below are placeholders only.
STRIPE_SUCCESS_URL=https://your-site.com/success
STRIPE_CANCEL_URL=https://your-site.com/cancel

# ---- Email Verification ----
# Mode: console (development, logs verification URLs to stdout) | resend (production)
# WARNING: console mode NEVER sends real email. If left as console in
# production, users cannot verify their accounts.
EMAIL_MODE=console

# Resend API key — REQUIRED when EMAIL_MODE=resend. Create one at https://resend.com/api-keys
RESEND_API_KEY=

# From address for verification emails. Resend requires this to be a verified
# sender (domain or address) in your Resend account.
EMAIL_FROM=AdVault Spy <noreply@advaulte.com>

# Public base URL used to build verification links.
# In production this must be the real HTTPS origin the app is served from,
# e.g. https://advaulte.com (never localhost) and it must be reachable by users
# (it is embedded in the emails they receive).
APP_BASE_URL=http://localhost:3000

# Optional override for the verification link base URL. When set, this wins
# over APP_BASE_URL. Leave empty to use APP_BASE_URL.
EMAIL_VERIFICATION_BASE_URL=

# Verification token expiry in hours
EMAIL_VERIFICATION_EXPIRY_HOURS=24
